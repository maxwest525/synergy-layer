# Every environment name this project READS, derived from the source on 2026-08-28.
# Names only, no values. A value here is a leaked secret.
#
# Regenerate (the codebase reads env by bracket access and by string literals
# passed to env helpers, so a plain `process.env.NAME` grep finds nothing):
#   rg -o --no-filename '"([A-Z][A-Z0-9]*(_[A-Z0-9]+)+)"' -r '$1' src --glob '!*.test.*' | sort -u
# then drop VITE_* names (those ship in the committed .env and are baked into
# the client at build time) and the few non-env constants the sweep also
# matches (auth events such as SIGNED_IN, embedding task types such as
# RETRIEVAL_QUERY).
#
# In production these are set in Lovable, not in a .env file. This exists so a
# variable cannot be declared, documented, and then read by nothing.

# ── Backend ───────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEYS=              # fallback: JSON keyset holding an sb_publishable_ key (src/lib/mcp/supabase.ts)
SUPABASE_ANON_KEY=                      # fallback: legacy name for the publishable key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=                    # fallback for SUPABASE_SERVICE_ROLE_KEY (src/lib/connectors/probes.server.ts)
LOVABLE_API_KEY=
AOOS_PUBLIC_ORIGIN=
AOOS_KNOWLEDGE_VERSION=                 # default: 2026-08-14
SEO_AEO_PLAYBOOK_PATH=
DATAFORSEO_PLAYBOOK_PATH=

# ── Self-hosted first. These win over the metered equivalents below. ──────────
# Defaults that already ship in src/lib/connectors/catalog.ts are shown as
# comments so nobody re-invents them; uncomment only to override.
SELFHOSTED_FIRECRAWL_BASE_URL=          # https://fire.marky.systems
SELFHOSTED_FIRECRAWL_API_KEY=
VPS_SCRAPER_BASE_URL=                   # default: https://crawl.marky.systems (Crawl4AI, NOT Firecrawl)
VPS_SCRAPER_API_KEY=
LITELLM_BASE_URL=
LITELLM_PROXY_API_BASE=                 # fallback name for LITELLM_BASE_URL
LITELLM_API_KEY=
LITELLM_PROXY_API_KEY=                  # fallback name for LITELLM_API_KEY
LITELLM_MODEL_REASONING=
LITELLM_MODEL_FAST=
LITELLM_MODEL_WORDING=
LITELLM_REFERER=                        # OpenRouter attribution header, cosmetic
LITELLM_APP_TITLE=                      # OpenRouter attribution header, cosmetic
N8N_BASE_URL=                           # default: https://n8n.marky.systems
N8N_SEO_WORKFLOW_WEBHOOK_URL=           # default: https://n8n.marky.systems/webhook/aoos-governed-seo
N8N_WEBHOOK_SECRET=
OPENSEO_BASE_URL=
OPENSEO_USERNAME=
OPENSEO_PASSWORD=
UMAMI_BASE_URL=
UMAMI_BEARER_TOKEN=                     # any one of the three Umami auth paths
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=                         # pairs with UMAMI_USERNAME

# ── Metered. Only reached when the self-hosted equivalent is absent. ──────────
FIRECRAWL_API_KEY=
DATAFORSEO_BASIC_TOKEN=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=
PERPLEXITY_API_KEY=

# ── Google ────────────────────────────────────────────────────────────────────
# Search Console, direct to Google. Preferred: it does not depend on Lovable, so
# it survives a publish and a deleted connector. Either the service account, or
# the OAuth trio.
GSC_SERVICE_ACCOUNT_JSON=
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=
# Fallback route, through the Lovable connector gateway.
GOOGLE_SEARCH_CONSOLE_API_KEY=
GA4_SERVICE_ACCOUNT_JSON=
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=
PAGESPEED_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=                           # default: gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=                 # default: gemini-embedding-001

# ── Other ─────────────────────────────────────────────────────────────────────
GITHUB_EXECUTOR_TOKEN=
OPENAI_ADS_BRIDGE_SECRET=
OPENAI_ADS_CAPI_API_KEY=
OPENAI_ADS_CAPI_BRIDGE_SECRET=      # falls back to OPENAI_ADS_BRIDGE_SECRET
